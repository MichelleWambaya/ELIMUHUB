# PAYMENT_PROVIDER options:
#   manual - student pays your till/QR directly, submits the transaction
#            code, an admin verifies it. No Daraja credentials needed.
#   dev    - simulates an instant successful payment, for local testing.
#   mpesa  - real Daraja STK Push. Requires the values below and a
#            working Business Admin/Manager login on the M-PESA portal.
PAYMENT_PROVIDER=manual
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-app.vercel.app/api/payments/mpesa/callback

# C2B: lets Safaricom auto-notify you whenever someone pays your till
# directly (by QR or manual till entry) — this is what makes the manual
# till/QR flow confirm automatically instead of needing an admin to check
# every code. Register these once from Admin > Automatic till payments.
DARAJA_C2B_VALIDATION_URL=https://your-app.vercel.app/api/payments/mpesa/c2b/validation
DARAJA_C2B_CONFIRMATION_URL=https://your-app.vercel.app/api/payments/mpesa/c2b/confirmation
